{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/example.json",
  "type": "object",
  "default": {},
  "title": "Root Schema",
  "required": [
      "title",
      "salary",
      "equity",
      "company_handle"
  ],
  "properties": {
      "title": {
          "type": "string",
          "default": "",
          "title": "The title Schema",
          "examples": [
              "Job Title String"
          ]
      },
      "salary": {
          "type": "integer",
          "default": 0,
          "title": "The salary Schema",
          "minimum": 0,
          "examples": [
              50000
          ]
      },
      "equity": {
          "type": "number",
          "default": 0.0,
          "title": "The equity Schema",
          "minimum": 0,
          "maximum": 1.0,
          "examples": [
              1.0
          ]
      },
      "company_handle": {
          "type": "string",
          "default": "",
          "title": "The company_handle Schema",
          "maxLength": 25,
          "examples": [
              "Company handle string"
          ]
      }
  },
  "examples": [{
      "title": "Job Title String",
      "salary": 50000,
      "equity": 1.0,
      "company_handle": "Company handle string"
  }]
}